# Salin menjadi `.env` untuk menimpa pengaturan docker compose.
# Berkas `.env` dibaca otomatis oleh compose dan tidak ikut ke git.

# Port di host tempat aplikasi dibuka. Di dalam kontainer nginx tetap di 80.
CLIENT_PORT=8080

# Kosongkan agar klien menyambung ke /ws pada origin yang sama — ini yang
# dipakai compose, dan yang membuat satu image bisa dipakai di domain mana pun.
# Isi HANYA bila server catur dijalankan terpisah dari kliennya,
# contoh: wss://catur.example.com
VITE_SERVER_URL=
